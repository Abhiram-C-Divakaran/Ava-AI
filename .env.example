# ==============================================================================
# Ava AI — Development Environment Configuration Example
# Copy this file to .env for local development.
# For production and Docker deployments, see .env.production.example.
# ==============================================================================

# Application Environment ('development' or 'production')
ENVIRONMENT=development

# Session Signing Secret (In development a fallback dev secret is used if empty)
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev_insecure_secret_key_change_in_production_1234567890

# CORS Allowed Origins (comma-separated list of origins)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Admin Portal Password
ADMIN_PASSWORD=admin

# Code Execution Safety Flag
ENABLE_CODE_EXECUTION=false

# SQLite Database Location (Local relative path for development)
DB_PATH=neurosupport.db

# Storage Directories for Uploads & Reviews (Local relative paths for development)
UPLOAD_DIR=uploads
REVIEW_IMAGE_DIR=review_images

# LLM & Voice Transcription Provider (Groq API — llama-3.3-70b-versatile, whisper-large-v3)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# External Integration API Keys (Optional)
BRAVE_API_KEY=
DEEPL_API_KEY=
REPLICATE_API_KEY=

# Google OAuth 2.0 (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
