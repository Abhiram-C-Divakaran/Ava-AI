# ==============================================================================
# Ava AI — Production Environment Configuration Example
# Use this configuration in production Docker deployments.
# Container persistent volumes must map to /app/data.
# ==============================================================================

# Application Environment ('production' enforces security invariants and HTTPS cookies)
ENVIRONMENT=production

# Session Signing Secret (MANDATORY: 32+ cryptographically random bytes)
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Enforce HTTPS-only Secure session cookies (set to 'false' only if terminating TLS upstream without proxy headers)
SESSION_HTTPS_ONLY=true

# CORS Allowed Origins (comma-separated list of production origins)
ALLOWED_ORIGINS=https://yourdomain.example

# Admin Portal Password (MANDATORY in production)
ADMIN_PASSWORD=

# Code Execution Safety Flag ('false' strongly enforced in multi-user production)
ENABLE_CODE_EXECUTION=false

# SQLite Database Location (Production volume path)
DB_PATH=/app/data/neurosupport.db

# Storage Directories for Uploads & Reviews (Production volume path)
UPLOAD_DIR=/app/data/uploads
REVIEW_IMAGE_DIR=/app/data/review_images

# LLM & Voice Transcription Provider (Groq API — llama-3.3-70b-versatile, whisper-large-v3)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# External Integration API Keys (Optional — system starts normally if unset)
BRAVE_API_KEY=
DEEPL_API_KEY=
REPLICATE_API_KEY=

# Google OAuth 2.0 (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://yourdomain.example/api/auth/google/callback
